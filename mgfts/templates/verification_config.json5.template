// Layer 6 verification configuration template
{
  project: "{{project_name}}",
  proof_dirs: ["verification", "proofs"],
  artifact_patterns: [
    "*.smt2", "*.smt", "*.smtlib", "*.v", "*.thy", "*.lean",
    "*.tla", "*.cfg", "*.als", "*.smv", "*.dfy", "*.fst", "*.lh",
    "*.l6spec", "*.contracts"
  ],
  targets: [
    {
      name: "{{target_name}}",
      type: "safety", // safety | liveness | refinement | contract
      artifacts: ["verification/{{target_name}}/obligation.smt2"],
      spec_path: "docs/specs/{{target_name}}.md",
      status: "pending",
      owner: "{{owner}}"
    }
  ],
  tools: [
    {
      name: "z3",
      type: "smt_solver",
      enabled: true,
      optional: true,
      artifact_patterns: ["*.smt2"],
      targets: ["safety", "invariants"],
      command: "z3 -smt2 {artifact}"
    },
    {
      name: "tla+",
      type: "model_checker",
      enabled: false,
      optional: true,
      artifact_patterns: ["*.tla", "*.cfg"],
      targets: ["liveness", "safety"],
      command: "tlc {artifact}"
    }
  ],
  reporting: {
    emit_reports: true,
    report_dir: "verification/report",
    include_optional_checks: false
  }
}
