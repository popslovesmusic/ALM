{
  id: "{{CONCEPT_ID}}",
  name: "{{CONCEPT_NAME}}",
  category: "{{CATEGORY}}",
  layer: {{LAYER_NUMBER}},
  status: "active",
  existence: {
    predicates: [
      "{{PREDICATE_1}}",
      "{{PREDICATE_2}}"
    ],
    ceases_when: ["{{CEASE_CONDITION}}"],
    evidence: ["{{EVIDENCE_PATH}}"],
