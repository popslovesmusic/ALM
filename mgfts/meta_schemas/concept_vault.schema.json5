// JSON Schema for GLOBAL_CONCEPT_VAULT.json5
// Layer 7: Ontological Foundation
// Validates concept existence predicates, truth maintenance, and relationship integrity
{
  $schema: "http://json-schema.org/draft-07/schema#",
  $id: "https://mgfts.org/schemas/concept_vault.schema.json5",
  title: "Global Concept Vault Schema",
  description: "Schema for MGFTS Global Concept Vault with Layer 7 ontological fields",
  type: "object",

  required: ["vault_version", "concepts", "relationships", "metadata"],

  properties: {
    vault_version: { type: "string", pattern: "^\\d+\\.\\d+\\.\\d+$" },
    project: { type: "string" },
    created: { type: "string" },
    last_modified: { type: "string" },

    concepts: {
      type: "array",
      minItems: 1,
      items: { $ref: "#/definitions/concept" }
    },

    relationships: {
      type: "array",
      items: { $ref: "#/definitions/relationship" },
      uniqueItems: false
    },

    ontology: {
      type: "object",
      description: "Vault-level ontology controls",
      properties: {
        existence_predicates: {
          type: "array",
          items: { $ref: "#/definitions/existence_predicate" }
        },
        truth_maintenance: {
          type: "object",
          properties: {
            source_of_truth: { type: "string" },
            revision_triggers: { type: "array", items: { type: "string" } },
            conflict_resolution: { type: "string" }
          }
        }
      }
    },

    metadata: {
      type: "object",
      properties: {
        total_concepts: { type: "integer", minimum: 0 },
        active_concepts: { type: "integer", minimum: 0 },
        deprecated_concepts: { type: "integer", minimum: 0 },
        layers_covered: { type: "array", items: { type: "integer", minimum: 1, maximum: 7 } },
        last_validation: { type: "string" }
      }
    }
  },

  definitions: {
    concept: {
      type: "object",
      required: ["id", "name", "layer", "existence", "truth_maintenance"],
      properties: {
        id: { type: "string" },
        name: { type: "string" },
        aliases: { type: "array", items: { type: "string" } },
        category: { type: "string" },
        status: { type: "string" },
        layer: { type: "integer", minimum: 1, maximum: 7 },
        introduced: { type: "string" },
        existence: { $ref: "#/definitions/existence" },
        truth_maintenance: { $ref: "#/definitions/truth_maintenance" },
        relationships: {
          type: "array",
          items: { $ref: "#/definitions/relationship" }
        }
      }
    },

    existence: {
      type: "object",
      required: ["predicates"],
      properties: {
        predicates: {
          type: "array",
          minItems: 1,
          items: { type: "string" }
        },
        ceases_when: {
          type: "array",
          items: { type: "string" }
        },
        evidence: {
          type: "array",
          items: { type: "string" }
        },
        validation: {
          type: "object",
          properties: {
            method: { type: "string" },
            frequency: { type: "string" },
            steward: { type: "string" }
          }
        }
      }
    },

    truth_maintenance: {
      type: "object",
      required: ["source_of_truth", "assertion_policy", "conflict_resolution"],
      properties: {
        source_of_truth: { type: "string" },
        assertion_policy: { type: "string" },
        revision_triggers: { type: "array", items: { type: "string" } },
        conflict_resolution: { type: "string" }
      }
    },

    relationship: {
      type: "object",
      required: ["from", "to", "type", "description"],
      properties: {
        from: { type: "string" },
        to: { type: "string" },
        type: { type: "string" },
        description: { type: "string" }
      }
    },

    existence_predicate: {
      type: "object",
      required: ["name", "description"],
      properties: {
        name: { type: "string" },
        description: { type: "string" },
        applies_to: { type: "array", items: { type: "string" } }
      }
    }
  }
}
