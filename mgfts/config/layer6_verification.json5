// Default Layer 6 formal verification registry
{
  project: "ALM",
  proof_dirs: ["verification", "proofs"],
  artifact_patterns: [
    "*.smt2", "*.smt", "*.smtlib", "*.v", "*.thy", "*.lean",
    "*.tla", "*.cfg", "*.als", "*.smv", "*.dfy", "*.fst", "*.lh",
    "*.l6spec", "*.contracts"
  ],
  targets: [
    {
      name: "governance_axioms",
      type: "safety",
      artifacts: ["verification/governance/axioms.smt2"],
      spec_path: "mgfts/CONSTITUTIONAL_AXIOMS.md",
      status: "pending",
      owner: "governance-team"
    }
  ],
  tools: [
    {
      name: "z3",
      type: "smt_solver",
      enabled: true,
      optional: true,
      artifact_patterns: ["*.smt2", "*.smt", "*.smtlib"],
      targets: ["safety", "invariants"],
      command: "z3 -smt2 {artifact}"
    },
    {
      name: "coq",
      type: "theorem_prover",
      enabled: false,
      optional: true,
      artifact_patterns: ["*.v"],
      targets: ["refinement", "contracts"],
      command: "coqtop -l {artifact}"
    }
  ],
  reporting: {
    emit_reports: true,
    report_dir: "verification/report",
    include_optional_checks: false
  }
}
